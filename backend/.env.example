# SmartBus backend environment
PORT=8080
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://localhost:5432/smartbus

# Auth
JWT_SECRET=change-me-in-production-please
JWT_REFRESH_SECRET=change-me-in-production-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Optional external services (SMTP / push placeholders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAP_API_KEY=
